#!/usr/bin/env python3
import sys, os, subprocess, time, json, socket, shutil

# ==============================================================================
# 1. MITMPROXY ADDON INTERCEPTION LOGIC
# (Loaded automatically when mitmdump runs: mitmdump -s /path/to/gem)
# ==============================================================================
try:
    from mitmproxy import http
    def response(flow: http.HTTPFlow) -> None:
        try:
            if "onboardUser" in flow.request.path:
                body = flow.response.get_text()
                if flow.response.status_code == 403 or "not eligible" in body.lower() or "PERMISSION_DENIED" in body or flow.response.status_code != 200:
                    flow.response.status_code = 200
                    flow.response.set_text(json.dumps({
                        "name": "operations/onboard-user-success",
                        "done": True,
                        "response": {
                            "@type": "type.googleapis.com/google.internal.cloud.code.v1internal.OnboardUserResponse",
                            "status": {"statusCode": "OK"}
                        }
                    }))
            elif "loadCodeAssist" in flow.request.path:
                body = flow.response.get_text()
                try:
                    data = json.loads(body)
                    if "ineligibleTiers" in data:
                        allowed = data.get("allowedTiers", [])
                        if not allowed:
                            allowed = [{"id": "standard-tier", "name": "Antigravity", "isDefault": True}]
                        data["allowedTiers"] = allowed
                        del data["ineligibleTiers"]
                        flow.response.set_text(json.dumps(data))
                except Exception:
                    pass
            elif "regionCode" in flow.response.get_text() and ("fetchUserInfo" in flow.request.path or "fetchAdminControls" in flow.request.path):
                try:
                    data = json.loads(flow.response.get_text())
                    if "regionCode" in data and data["regionCode"] != "US":
                        data["regionCode"] = "US"
                        flow.response.set_text(json.dumps(data))
                except Exception:
                    pass
        except Exception:
            pass
except ImportError:
    pass

# ==============================================================================
# 2. INTERNAL PROXY RUNNER WORKER
# (Invoked automatically inside the tmux session when gem starts agy)
# ==============================================================================
def run_proxy_worker(cmd_args):
    if not shutil.which("mitmdump"):
        print("\n[Error] mitmdump not found!")
        print("mitmproxy is required by agy-tmux for region check bypass.")
        print("Please reinstall using install.sh (`curl -sL ... | bash`) or install mitmproxy manually (`pip install mitmproxy`).\n")
        sys.exit(1)

    real_agy = os.path.expanduser("~/.local/bin/agy")
    if not os.path.exists(real_agy):
        real_agy = shutil.which("agy") or "/root/.local/bin/agy"
        if not os.path.exists(real_agy):
            print("Error: agy executable not found!")
            sys.exit(1)

    cert_file = os.path.expanduser("~/.mitmproxy/mitmproxy-ca-cert.pem")
    
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.bind(("", 0))
        port = s.getsockname()[1]

    env = os.environ.copy()
    env["MITMPROXY_ADDON_RUN"] = "1"

    proxy_proc = subprocess.Popen(
        ["mitmdump", "-q", "-p", str(port), "-s", os.path.abspath(__file__)],
        env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )

    try:
        for _ in range(100):
            time.sleep(0.05)
            try:
                with socket.create_connection(("127.0.0.1", port), timeout=0.1):
                    break
            except Exception:
                pass

        env["HTTP_PROXY"] = f"http://127.0.0.1:{port}"
        env["HTTPS_PROXY"] = f"http://127.0.0.1:{port}"
        env["SSL_CERT_FILE"] = cert_file

        run_cmd = [real_agy] + cmd_args
        res = subprocess.run(run_cmd, env=env)
        sys.exit(res.returncode)
    finally:
        proxy_proc.terminate()
        try:
            proxy_proc.wait(timeout=1)
        except Exception:
            proxy_proc.kill()

# ==============================================================================
# 3. TMUX SESSION MANAGEMENT & CLI ENTRYPOINT
# ==============================================================================
def print_help():
    print("Usage: gem [options] [suffix]")
    print("")
    print("Manage tmux sessions for agy (Antigravity CLI) with built-in region bypass.")
    print("")
    print("Commands & Options:")
    print("  -h, --help, h, help      Show this help message")
    print("  -s, --session SUFFIX     Open or create session agy-<suffix>")
    print("  -d, --delete SUFFIX      Delete session agy-<suffix> (or 'agy' if no suffix)")
    print("  -l, --list, l, list      List all active tmux sessions")
    print("  -c, --continue, c        Start agy with the last dialog (agy -c) if session is created")
    print("  [suffix]                 Open or create session agy-<suffix> (positional)")
    print("  d [suffix]               Delete session agy-<suffix> (positional)")
    print("")
    print("Examples:")
    print("  gem                      Open/create session 'agy' and run 'agy' (with bypass)")
    print("  gem 1                    Open/create session 'agy-1' and run 'agy' (with bypass)")
    print("  gem c                    Open/create session 'agy' and run 'agy -c' (with bypass)")
    print("  gem c 1                  Open/create session 'agy-1' and run 'agy -c' (with bypass)")
    print("  gem -d 1 / gem d 1       Delete session 'agy-1'")
    print("  gem -l / gem l           List all active tmux sessions")

def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--internal-proxy-run":
        cmd_args = ["-c"] if len(sys.argv) >= 3 and sys.argv[2] == "-c" else sys.argv[2:]
        run_proxy_worker(cmd_args)
        return

    subprocess.run(["tmux", "set-option", "-g", "mouse", "on"], stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["tmux", "set-option", "-g", "status", "off"], stderr=subprocess.DEVNULL, check=False)

    suffix = ""
    cont = False
    delete = False
    list_sessions = False
    help_flag = False

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-h", "--help", "h", "help"):
            help_flag = True
            i += 1
        elif arg in ("-s", "--session"):
            if i + 1 < len(args):
                suffix = args[i+1]
                i += 2
            else:
                i += 1
        elif arg in ("-d", "--delete", "d", "delete"):
            delete = True
            if i + 1 < len(args) and not args[i+1].startswith("-") and args[i+1] not in ("c", "l"):
                suffix = args[i+1]
                i += 2
            else:
                i += 1
        elif arg in ("-l", "--list", "l", "list"):
            list_sessions = True
            i += 1
        elif arg in ("-c", "--continue", "c", "continue"):
            cont = True
            i += 1
        else:
            if not suffix:
                suffix = arg
            i += 1

    if help_flag:
        print_help()
        sys.exit(0)

    if list_sessions:
        res = subprocess.run(["tmux", "list-sessions"], check=False)
        if res.returncode != 0:
            print("No active tmux sessions.")
        sys.exit(0)

    session_name = f"agy-{suffix}" if suffix else "agy"

    if delete:
        res = subprocess.run(["tmux", "has-session", "-t", session_name], stderr=subprocess.DEVNULL, check=False)
        if res.returncode == 0:
            subprocess.run(["tmux", "kill-session", "-t", session_name], check=False)
            print(f"Session '{session_name}' deleted successfully.")
        else:
            print(f"Session '{session_name}' does not exist.")
        sys.exit(0)

    res = subprocess.run(["tmux", "has-session", "-t", session_name], stderr=subprocess.DEVNULL, check=False)
    if res.returncode != 0:
        subprocess.run(["tmux", "new-session", "-d", "-s", session_name], check=False)
        subprocess.run(["tmux", "set-option", "-t", session_name, "mouse", "on"], stderr=subprocess.DEVNULL, check=False)
        subprocess.run(["tmux", "set-option", "-t", session_name, "status", "off"], stderr=subprocess.DEVNULL, check=False)

        self_path = os.path.abspath(__file__)
        internal_arg = "-c" if cont else ""
        cmd = f"source ~/.bashrc 2>/dev/null; '{self_path}' --internal-proxy-run {internal_arg}; exit"
        subprocess.run(["tmux", "send-keys", "-t", session_name, cmd, "C-m"], check=False)

    if os.environ.get("TMUX"):
        subprocess.run(["tmux", "switch-client", "-t", session_name], check=False)
    else:
        subprocess.run(["tmux", "attach-session", "-t", session_name], check=False)

if __name__ == "__main__":
    if not os.environ.get("MITMPROXY_ADDON_RUN"):
        main()
